# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
# Restart `npx expo start` after changing it.

# OpenAI-compatible AI gateway used for everything (speech-to-text + summary).
EXPO_PUBLIC_AI_BASE_URL=https://hhtechapi.com/v1
EXPO_PUBLIC_AI_API_KEY=

# Summary models. The one picked in Settings runs first, the other is the fallback.
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-v4-pro
EXPO_PUBLIC_GROK_MODEL=grok-4.7

# DeepSeek and Grok cannot listen to audio, so speech-to-text uses audio-capable models
# (comma-separated: the next one is used when the previous is down).
EXPO_PUBLIC_TRANSCRIBE_MODEL=gemini-3.7-flash,gemini-3.6-flash
